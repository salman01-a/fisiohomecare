# Server
PORT=3000
NODE_ENV=development

# Database (Cloud SQL - MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fisiohomecare
DB_USER=root
DB_PASSWORD=your_password_here
DB_DIALECT=mysql

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS (Frontend web URL)
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (opsional - untuk auth mobile)
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# Google Cloud Storage (opsional - untuk production file upload)
# GCS_BUCKET_NAME=fisiohomecare-media

# Catatan Mobile Dev:
# Untuk Flutter emulator Android, gunakan IP: http://10.0.2.2:3000/v1
# Untuk Flutter di device fisik, gunakan IP lokal mesin: http://192.168.x.x:3000/v1
# Update mobile/lib/config/api_config.dart dengan IP yang sesuai
